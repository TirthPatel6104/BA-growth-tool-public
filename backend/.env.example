# ---------------------------------------------------------------------------
# Basal Area Growth Tool – backend environment (copy to backend/.env)
# All values are optional. With nothing set, the API uses a local SQLite file.
# ---------------------------------------------------------------------------

# --- Database -----------------------------------------------------------------
# 1) Zero-config demo (default): SQLite file at backend/demo_basal_growth.db
#    Override the file location if you like:
# BAGT_SQLITE_PATH=./demo_basal_growth.db

# 2) PostgreSQL ("real" deployment) – requires psycopg2-binary (in requirements.txt)
# DATABASE_URL=postgresql://bagt:bagt@localhost:5432/bagt

# 3) Microsoft SQL Server (optional) – requires: pip install -r requirements-mssql.txt
#    Either a full SQLAlchemy URL ...
# DATABASE_URL=mssql+pyodbc://user:password@SERVER/demo_growth_db?driver=ODBC+Driver+17+for+SQL+Server
#    ... or the legacy keyword settings (a raw ODBC string wins over the keywords):
# BAGT_SQL_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=demo_growth_db;Trusted_Connection=yes;
# BAGT_SQL_SERVER=localhost
# BAGT_SQL_DATABASE=demo_growth_db
# BAGT_SQL_DRIVER=ODBC Driver 17 for SQL Server
# BAGT_SQL_TRUSTED=yes
# BAGT_SQL_USER=demo_user
# BAGT_SQL_PASSWORD=demo_password
# BAGT_SQL_ENCRYPT=no
# BAGT_SQL_TRUST_SERVER_CERT=yes
# BAGT_SQL_LOGIN_TIMEOUT=60
# BAGT_SQL_QUERY_TIMEOUT=0
# BAGT_SQL_LOCK_TIMEOUT_MS=-1

# --- Start-up behaviour ---------------------------------------------------------
# Run `alembic upgrade head` automatically on start-up (default: true for SQLite only)
# BAGT_AUTO_MIGRATE=true
# Seed the synthetic demo dataset when the coefficient table is empty (default: true for SQLite only)
# BAGT_AUTO_SEED=true
# Log every SQL statement
# BAGT_SQL_ECHO=false

# --- API ------------------------------------------------------------------------
# Extra CORS origins (comma-separated) on top of the localhost Vite defaults
# BAGT_CORS_ORIGINS=https://demo.example.org
# ENV=development

# --- TCR spatial lookup (optional, FindTCR.py / data/extractors.py) ---------------
# BAGT_TCR_SHAPEFILE=tcr_polygons.shp
# BAGT_TCR_TRAIN_CSV=training_data.csv
# BAGT_TCR_OUT_CSV=ba_growth_train_with_TCR.csv

# ---------------------------------------------------------------------------
# Optional: site-specific stored procedures on SQL Server (see sql/README.md).
# Off by default – every dialect reads the portable tblBAGrowthData table.
# ---------------------------------------------------------------------------
# BAGT_USE_STORED_PROCEDURES=false

# Optional: coordinates file for FindTCR.py when the training CSV has none
# BAGT_TCR_COORDS_CSV=plot_coordinates.csv
