  "components": {
    "schemas": {
      "AutoPredictRequest": {
        "properties": {
          "species_abbrev": {
            "type": "string",
            "title": "Species Abbrev",
            "description": "Species abbreviation, e.g. Mh, Or, Cedar"
          },
          "forest_unit": {
            "type": "string",
            "title": "Forest Unit",
            "description": "Forest unit, e.g. TH1, HDSL2"
          },
          "current_year": {
            "type": "integer",
            "title": "Current Year",
            "description": "Projection start year"
          },
          "projection_years": {
            "type": "integer",
            "title": "Projection Years",
            "description": "Number of years to project",
            "default": 10
          },
          "model_version": {
            "type": "string",
            "title": "Model Version",
            "default": "1.0"
          }
        },
        "type": "object",
        "required": [
          "species_abbrev",
          "forest_unit",
          "current_year"
        ],
        "title": "AutoPredictRequest"
      },
      "BatchPredictRequest": {
        "properties": {
          "rows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Rows"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version",
            "default": "1.0"
          }
        },
        "type": "object",
        "required": [
          "rows"
        ],
        "title": "BatchPredictRequest"
      },
      "BenchmarkRequest": {
        "properties": {
          "groups": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Groups",
            "description": "Model groups (e.g. ['Mh','FU_TH1']); default = all"
          },
          "models": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Models",
            "description": "Algorithm names from /api/benchmarks/models; default = all available"
          },
          "cv_strategy": {
            "type": "string",
            "title": "Cv Strategy",
            "description": "group | temporal | kfold",
            "default": "group"
          },
          "n_splits": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 2.0,
            "title": "N Splits",
            "default": 5
          },
          "seed": {
            "type": "integer",
            "title": "Seed",
            "default": 42
          },
          "feature_set": {
            "type": "string",
            "title": "Feature Set",
            "description": "base | extended",
            "default": "base"
          },
          "alpha": {
            "type": "number",
            "exclusiveMaximum": 0.5,
            "exclusiveMinimum": 0.0,
            "title": "Alpha",
            "description": "Prediction-interval miscoverage",
            "default": 0.1
          },
          "leakage_check": {
            "type": "boolean",
            "title": "Leakage Check",
            "default": true
          },
          "temporal_check": {
            "type": "boolean",
            "title": "Temporal Check",
            "default": true
          },
          "intervals": {
            "type": "boolean",
            "title": "Intervals",
            "default": true
          },
          "importance": {
            "type": "boolean",
            "title": "Importance",
            "default": true
          },
          "populate_tcr": {
            "type": "boolean",
            "title": "Populate Tcr",
            "description": "Override TCR from the shapefile during extraction",
            "default": false
          }
        },
        "type": "object",
        "title": "BenchmarkRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PredictRequest": {
        "properties": {
          "spec_code": {
            "type": "integer",
            "title": "Spec Code",
            "description": "Species code, e.g. 30 = Hard Maple"
          },
          "forest_unit": {
            "type": "string",
            "title": "Forest Unit",
            "description": "Forest unit, e.g. 'TH1'"
          },
          "BA": {
            "type": "number",
            "title": "Ba",
            "description": "Basal area (m\u00b2/ha)"
          },
          "AGSfrac": {
            "type": "number",
            "title": "Agsfrac",
            "description": "AGS fraction (0\u20131), provide measured value"
          },
          "TCR": {
            "type": "integer",
            "title": "Tcr",
            "description": "Timber capability rating (1\u20137)",
            "default": 5
          },
          "DQ": {
            "type": "number",
            "title": "Dq",
            "description": "Quadratic mean diameter (cm)"
          },
          "q": {
            "type": "number",
            "title": "Q",
            "description": "q-factor"
          },
          "Cut": {
            "type": "integer",
            "title": "Cut",
            "description": "Cutting indicator (0 or 1)",
            "default": 0
          },
          "easting": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Easting",
            "description": "Easting (NAD83 EPSG:26917)"
          },
          "northing": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Northing",
            "description": "Northing (NAD83 EPSG:26917)"
          },
          "projection_years": {
            "type": "integer",
            "title": "Projection Years",
            "description": "Years to project (0 = single step)",
            "default": 0
          },
          "model_version": {
            "type": "string",
            "title": "Model Version",
            "default": "1.0"
          }
        },
        "type": "object",
        "required": [
          "spec_code",
          "forest_unit",
          "BA",
          "AGSfrac",
          "DQ",
          "q"
        ],
        "title": "PredictRequest"
      },
      "TrainRequest": {
        "properties": {
          "species_abbrev": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Species Abbrev",
            "description": "Train one species model, e.g. 'Mh', 'Cedar'"
          },
          "forest_unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Forest Unit",
            "description": "Train one forest-unit model, e.g. 'TH1', 'HDSL2'"
          },
          "train_all": {
            "type": "boolean",
            "title": "Train All",
            "description": "Train all configured models",
            "default": false
          },
          "save_to_db": {
            "type": "boolean",
            "title": "Save To Db",
            "description": "Persist coefficients",
            "default": true
          },
          "populate_tcr": {
            "type": "boolean",
            "title": "Populate Tcr",
