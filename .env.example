# =============================================================================
# Basal Area Growth Tool - Backend Configuration Example
# Copy this file to backend/.env for local overrides (the API loads backend/.env).
# The full, documented list lives in backend/.env.example.
# =============================================================================

# Server Environment
ENV=development
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# CORS Configuration (extra comma-separated origins on top of the Vite defaults)
BAGT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Database (SQLAlchemy 2.0 + Alembic). Leave everything below commented out to
# use the zero-config SQLite demo file backend/demo_basal_growth.db.
# -----------------------------------------------------------------------------

# PostgreSQL deployment
# DATABASE_URL=postgresql://bagt:bagt@localhost:5432/bagt

# Microsoft SQL Server (optional; pip install -r backend/requirements-mssql.txt)
# Setting BAGT_SQL_SERVER (or BAGT_SQL_CONNECTION_STRING) switches the app to MSSQL.
# BAGT_SQL_DRIVER=ODBC Driver 17 for SQL Server
# BAGT_SQL_SERVER=localhost
# BAGT_SQL_DATABASE=demo_growth_db
# BAGT_SQL_TRUSTED=yes
# BAGT_SQL_USER=demo_user
# BAGT_SQL_PASSWORD=demo_password
# BAGT_SQL_LOGIN_TIMEOUT=30
# BAGT_SQL_QUERY_TIMEOUT=0

# Start-up behaviour (defaults: true for SQLite, false for other dialects)
# BAGT_AUTO_MIGRATE=true
# BAGT_AUTO_SEED=true
